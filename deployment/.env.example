# bulkhaul 全栈 compose 环境变量（复制为 .env 并填生产值；.env 已 gitignore）
# 本地开发可用默认值；生产必须覆盖敏感项。

# ---- 数据库 ----
DB_PASSWORD=blms123456
MYSQL_ROOT_PASSWORD=blms123456

# ---- JWT（生产必须覆盖；≥32 字节随机密钥，如 openssl rand -base64 48）----
JWT_SECRET=blms-demo-secret-key-change-me-0123456789abcdef
JWT_TTL_MINUTES=480

# ---- 服务端定时任务（C4：生产开启 leader 单实例执行）----
SCHEDULER_AUTO_ENABLED=true

# ---- 日志 ----
LOG_LEVEL_COM_BLMS=info
